{
  "name": "jobwalay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:races": "node scripts/run-race-tests.mjs",
    "worker:assessments": "node --env-file=.env.local scripts/assessment-worker.mjs",
    "test:integration": "node scripts/local.mjs test",
    "test:http": "node scripts/http-smoke.mjs",
    "setup:local": "node scripts/local.mjs setup",
    "db:test": "supabase test db",
    "db:types:embedded": "node scripts/generate-embedded-types.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "worker:notifications": "node --env-file=.env.local scripts/notification-worker.mjs",
    "test:e2e": "playwright test",
    "test:e2e:hiring": "node scripts/hiring-e2e.mjs",
    "clamav:configure": "node scripts/configure-local-clamav.mjs",
    "clamav:check": "node --env-file=.env.local scripts/check-clamav.mjs",
    "test:clamav": "node --env-file=.env.local scripts/test-clamav.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.4.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
