NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
APP_URL=http://localhost:3000
# Server-only. Scanner and isolated assessment/email workers; never use NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Private ClamAV daemon (INSTREAM). Missing/unavailable scanner blocks CV release.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Server scan timeout, 1000–45000 ms. Local Docker may need 30000 on low-memory hosts.
CLAMAV_SCAN_TIMEOUT_MS=30000
# Optional development-only, fixed-fixture diagnostic. Generate a random 64-char token.
# Never NEXT_PUBLIC; production diagnostics always return 404.
CLAMAV_DIAGNOSTIC_TOKEN=
# Optional isolated email worker. Disabled until provider/sender and consent are verified.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
